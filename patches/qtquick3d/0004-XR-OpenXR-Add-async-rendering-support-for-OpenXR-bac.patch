+// Prepares everything before beginRhiFrameAndSync() for the last (or only) render pass.
+// For multiview: sets the render target (cameras already set by prepareScene).
+// For non-multiview: renders all eyes except the last synchronously,
+// then prepares the last eye (camera + render target).
+// Returns false if any eye's swapchain wait fails.
+bool QQuick3DXrManagerPrivate::renderNonLastEyes()
+{
+    if (m_multiviewRendering) {
+        // Set render target here (not in beginFrame) because it may involve
+        // QRhi/GL calls that must run on the thread owning the graphics context.
+        const auto &eye = m_frameData.eyeSwapchainData[0];
+        setSwapchainRenderTarget(m_frameData.projectionLayerViews[0].subImage,
+                                 eye.swapchainImage, eye.depthSwapchainImage);
+        return true;
+    }
+
+    const quint32 lastEye = m_frameData.viewCountOutput - 1;
+    for (quint32 i = 0; i < lastEye; i++) {
+        if (!renderEyeSync(i))
+            return false;
+    }
+    prepareEyeForRender(lastEye);
+    return true;
+}
+
+// Async rendering — runs on the worker thread.
+// Precondition: beginFrame() already called on main thread.
+bool QQuick3DXrManagerPrivate::renderFrameOnWorker()
+{
+    if (renderNonLastEyes()) {
+        beginRhiFrameAndSync();
+        wakeMainThread();
+        return renderLastEyeAndSubmit();
+    } else {
+        wakeMainThread();
+        return submitXrEndFrame();
+    }
+}
+
+// Handles the last eye: waits for GPU, renders, then cleans up and submits xrEndFrame.
+// For multiview the "last eye" is eye 0 (single render pass).
+// For non-multiview, non-last eyes were already rendered by renderEyeSync().
+bool QQuick3DXrManagerPrivate::renderLastEyeAndSubmit()
+{
+    Q_Q(QQuick3DXrManager);
+
+    // The last eye's swapchain index: multiview uses swapchain 0,
+    // non-multiview uses the last per-eye swapchain.
+    const quint32 lastSwapchain = m_frameData.multiviewRendering ? 0 : m_frameData.viewCountOutput - 1;
+    const auto &lastEye = m_frameData.eyeSwapchainData[lastSwapchain];
+
+    // Wait for GPU to finish with the last eye's swapchain image.
+    XrSwapchainImageWaitInfo waitInfo{};
+    waitInfo.type = XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO;
+    waitInfo.timeout = XR_INFINITE_DURATION;
+    if (!checkXrResult(xrWaitSwapchainImage(m_swapchains[lastSwapchain].handle, &waitInfo))) {
+        qWarning("Failed to wait for swapchain image (eye %d)", lastSwapchain);
+        q->m_renderControl->endFrame();
+        submitXrEndFrame();
+        return false;
+    }
+    if (lastEye.hasDepthSwapchainImage) {
+        if (!checkXrResult(xrWaitSwapchainImage(m_depthSwapchains[lastSwapchain].handle, &waitInfo))) {
+            qWarning("Failed to wait for depth swapchain image (eye %d)", lastSwapchain);
+            q->m_renderControl->endFrame();
+            submitXrEndFrame();
+            return false;
+        }
+    }
+
+    rhiRenderAndEndFrame();
+    emit q->frameReady();
+
+#if QT_CONFIG(graphicsframecapture)
+    if (m_frameCapture)
+        m_frameCapture->endCaptureFrame();
+#endif
+
+    // Depth info for the last eye. For multiview, this covers all views.
+    // For non-multiview, non-last eyes' depth info was set by renderEyeSync().
+    if (m_frameData.multiviewRendering) {
+        for (quint32 i = 0; i < m_frameData.viewCountOutput; i++)
+            setupDepthInfoForEye(i);
+    } else {
+        setupDepthInfoForEye(lastSwapchain);
+    }
+
+    if (!releaseSwapchainForEye(lastSwapchain))
+        return false;
+
+    return submitXrEndFrame(true);
 }
 
