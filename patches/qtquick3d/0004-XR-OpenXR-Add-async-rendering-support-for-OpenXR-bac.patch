 void QQuick3DXrManagerPrivate::onFrameWaitCompleted(XrResult result, const XrFrameState &frameState)
 {
+    Q_Q(QQuick3DXrManager);
+
     if (!m_waitingForFrame)
         return;
     m_waitingForFrame = false;
+    m_renderingFrame = true;
 
     if (!checkXrResult(result)) {
         qWarning("xrWaitFrame failed");
+        onFrameRenderCompleted(false);
+        return;
+    }
+
+    m_frameData.frameState = frameState;
+    m_frameData.multiviewRendering = m_multiviewRendering;
+    m_frameData.fbPassthroughActive = updateFBPassthroughState();
+    m_frameData.submitLayerDepth = m_submitLayerDepth;
+    m_frameData.environmentBlendMode = m_environmentBlendMode;
+
+    if (frameState.shouldRender != XR_TRUE) {
+        onFrameRenderCompleted(submitEmptyFrame());
+        return;
+    }
+
+    if (!prepareScene(frameState.predictedDisplayTime, frameState.predictedDisplayPeriod)) {
+        onFrameRenderCompleted(submitEmptyFrame());
+        return;
+    }
+
+    q->m_renderControl->polishItems();
+
+    if (!beginFrame()) {
+        onFrameRenderCompleted(false);
+        return;
+    }
+
+    if (m_asyncRenderEnabled && m_worker) {
+        postEventAndWait([this]() { m_worker->startRendering(); });
+        // onFrameRenderCompleted() will be called via frameRendered signal
     } else {
-        doRenderFrameAferWait(frameState);
+        bool success;
+        if (renderNonLastEyes()) {
+            beginRhiFrameAndSync();
+            success = renderLastEyeAndSubmit();
+        } else {
+            success = submitXrEndFrame();
+        }
+        onFrameRenderCompleted(success);
     }
+}
 
+void QQuick3DXrManagerPrivate::onFrameRenderCompleted(bool success)
+{
+    if (!m_renderingFrame)
+        return;
+    m_renderingFrame = false;
+
+    if (!success) {
+        Q_Q(QQuick3DXrManager);
+        emit q->sessionEnded();
+        return;
+    }
+
+    scheduleUpdate();
+}
+
+void QQuick3DXrManagerPrivate::scheduleUpdate()
+{
     if (m_wantUpdate) {
         m_wantUpdate = false;
         update();
     }
 }
 
