+                                     && m_passthroughLayer != XR_NULL_HANDLE);
+        } else {
+            if (m_passthroughLayer)
+                pauseMetaQuestPassthroughLayer();
+            if (m_passthroughFeature)
+                pauseMetaQuestPassthrough();
+            m_fbPassthroughActive = false;
+        }
+    }
+    return m_fbPassthroughActive;
+}
