+// Moves the render control (and GL context for OpenGL) to the target thread.
+// For OpenGL, doneCurrent() must be called before moveToThread().
+static void moveRenderControlToThread(QQuickRenderControl *renderControl, QThread *thread)
+{
+#if defined(XR_USE_GRAPHICS_API_OPENGL) || defined(XR_USE_GRAPHICS_API_OPENGL_ES)
+    QRhi *rhi = renderControl->rhi();
+    if (rhi && rhi->backend() == QRhi::OpenGLES2) {
+        const auto *glNH = static_cast<const QRhiGles2NativeHandles *>(rhi->nativeHandles());
+        if (glNH && glNH->context) {
+            glNH->context->doneCurrent();
+            glNH->context->moveToThread(thread);
+        }
+    }
+#endif
+    renderControl->prepareThread(thread);
+}
